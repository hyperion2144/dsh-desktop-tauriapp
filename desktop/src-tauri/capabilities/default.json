{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-get-desktop-client-environment",
    "core:default",
    "notification:default",
    "core:window:allow-start-dragging",
    "allow-open-external",
    "allow-log-diag",
    "allow-log-console",
    "allow-choose-desktop-mode",
    "allow-get-mode-prompt-needed",
    "allow-get-dsh-status",
    "allow-restart-dsh-service",
    "allow-ui-input-confirm",
    "allow-pet-show-main",
    "allow-pet-hide",
    "allow-pet-quit",
    "allow-pet-toggle-passthrough",
    "allow-toggle-zoom",
    "allow-get-proxy-settings",
    "allow-save-proxy-settings",
    "allow-test-proxy-connectivity"
  ]
}
