{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-desktop",
  "description": "允许 DSH Web GUI（dsh web 子进程在 127.0.0.1/localhost 上提供（默认 3080，DSH_DESKTOP_PORT 可覆盖），对 Tauri 属 remote origin）通过 dsh-desktop-tauriapp 插件 client（AdvancedFrame 拖拽区 / 自绘窗口按钮）执行窗口命令：拖动主窗口、最小化/最大化/关闭、双击最大化。窗口覆盖主窗 main 与多开次窗 profile-*（#89，次窗同为 remote origin 且需同样的 chrome/设置 IPC）。仅放行窗口控制命令，最小化 remote 暴露面。",
  "remote": {
    "urls": [
      "http://127.0.0.1",
      "http://127.0.0.1:*",
      "http://127.0.0.1:3080",
      "http://localhost",
      "http://localhost:*",
      "http://localhost:3080"
    ]
  },
  "windows": [
    "main",
    "profile-*"
  ],
  "permissions": [
    "notification:default",
    "allow-open-external",
    "allow-log-diag",
    "allow-log-console",
    "allow-get-dsh-status",
    "allow-get-desktop-client-environment",
    "allow-restart-dsh-service",
    "allow-ui-input-confirm",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "allow-get-desktop-settings-data",
    "allow-save-desktop-settings",
    "allow-add-remote-address",
    "allow-remove-remote-address",
    "allow-select-remote-address",
    "allow-set-local-port",
    "allow-switch-profile-command",
    "allow-confirm-startup-profile",
    "allow-check-startup-needed",
    "allow-get-pending-active-profile",
    "allow-migrate-profile",
    "allow-list-runtime-catalog",
    "allow-download-runtime",
    "allow-remove-runtime",
    "allow-runtime-download-status",
    "allow-migration-status",
    "allow-task-status",
    "allow-get-dsh-source",
    "allow-set-dsh-source",
    "allow-list-profile-ports",
    "allow-list-profile-dependency-status",
    "allow-rebuild-profile-dependencies",
    "allow-set-profile-port",
    "allow-create-profile-flow-command",
    "allow-get-proxy-settings",
    "allow-save-proxy-settings",
    "allow-test-proxy-connectivity",
    "core:event:default",
    "allow-list-downloads",
    "allow-pause-download",
    "allow-resume-download",
    "allow-cancel-download",
    "allow-clear-finished-downloads",
    "allow-get-download-settings",
    "allow-set-download-concurrency",
    "allow-reveal-download",
    "allow-start-blob-download",
    "allow-save-blob-chunk",
    "allow-finish-blob-download",
    "allow-browser-guest-acquire",
    "allow-browser-guest-release",
    "allow-browser-guest-release-all",
    "allow-browser-guest-navigate",
    "allow-browser-guest-control",
    "allow-browser-guest-set-bounds",
    "allow-browser-guest-set-visible",
    "allow-browser-guest-state"
  ]
}
