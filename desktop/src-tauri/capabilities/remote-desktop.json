{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-desktop",
  "description": "允许 DSH Web GUI（dsh web 子进程在 127.0.0.1/localhost 上提供（默认 3080，DSH_DESKTOP_PORT 可覆盖），对 Tauri 属 remote origin）通过 dsh-desktop-tauriapp 插件 client（AdvancedFrame 拖拽区 / 自绘窗口按钮）执行窗口命令：拖动主窗口、最小化/最大化/关闭、双击最大化。仅放行窗口控制命令，最小化 remote 暴露面。",
  "remote": {
    "urls": [
      "http://127.0.0.1",
      "http://127.0.0.1:*",
      "http://127.0.0.1:3080",
      "http://localhost",
      "http://localhost:*",
      "http://localhost:3080"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "notification:default",
    "allow-open-external",
    "allow-log-diag",
    "allow-log-console",
    "allow-get-dsh-status",
    "allow-get-desktop-client-environment",
    "allow-restart-dsh-service",
    "allow-ui-input-confirm",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
